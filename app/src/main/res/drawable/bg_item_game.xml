<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="12dp" android:insetTop="5dp" android:insetRight="12dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/t_card"/>
                <stroke android:width="1.5dp" android:color="@color/t_primary"/>
                <corners android:radius="22dp"/>
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="12dp" android:insetTop="5dp" android:insetRight="12dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/t_card"/>
                <corners android:radius="22dp"/>
            </shape>
        </inset>
    </item>
</selector>
