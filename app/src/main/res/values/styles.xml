<resources>
    <style name="Tweak.Button" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Tweak.Button.Filled">
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:textColor">@color/t_on_primary</item>
    </style>
    <style name="Tweak.Button.Tonal">
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:textColor">@color/t_on_container</item>
    </style>
    <!-- Kolom input di dalam kartu: tanpa garis, angka besar -->
    <style name="Tweak.Input" parent="android:Widget.Material.EditText">
        <item name="android:background">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/t_on_surface</item>
        <item name="android:textColorHint">@color/t_outline</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TweakSection" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/t_on_surface</item>
    </style>
</resources>
